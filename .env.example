# Configuration publique Supabase, reprise du projet Lovable dans le fichier .env local.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Secret serveur requis pour enregistrer les messages du formulaire de contact.
# À renseigner uniquement dans le fichier .env local, jamais dans une variable VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# Origine utilisée par les fonctions de notification email du projet d'origine.
LOVABLE_PUBLIC_URL=
